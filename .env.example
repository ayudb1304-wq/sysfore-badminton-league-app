# ── Supabase (browser + server-side anon access) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Postgres direct connection for Drizzle (server-only) ─────────────────────
# Supabase Dashboard → Project Settings → Database → Connection string → URI.
# Use the *Session* pooler (port 6543) for serverless / Next.js server actions.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-DB-PASSWORD@aws-X-REGION.pooler.supabase.com:6543/postgres

# ── Service role key (server-only — NEVER expose to the browser) ─────────────
# Used by scripts/import-fixtures.ts and admin server actions to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Tournament metadata ──────────────────────────────────────────────────────
# Excel fixtures carry only times-of-day; this seeds the date for scheduled_start.
TOURNAMENT_DATE=2026-XX-XX
